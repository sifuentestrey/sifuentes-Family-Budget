# Copy to .env for local development. .env is gitignored.
#
# In production these are Supabase secrets, NOT a .env file:
#   supabase secrets set PLAID_CLIENT_ID=... PLAID_SECRET=...
# Plaid access tokens are never listed here — they go into Supabase Vault via
# store_vault_secret() and are referenced by name from items.token_ref.

PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production

# Shared secret the cron job presents to the sync function.
SYNC_SECRET=

# Server-side only. Never expose the service role key to the browser — it
# bypasses RLS entirely.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Safe for the browser: RLS restricts it to the signed-in user's household.
SUPABASE_ANON_KEY=
